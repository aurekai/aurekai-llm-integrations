{
  "name": "@aurekai/llm-integrations",
  "version": "0.8.0-alpha.1",
  "description": "Provider-neutral Aurekai LLM binding layer — 48 operators, 9 families, 9 providers, canonical tool schema, evals harness.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurekai/aurekai-llm-integrations.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "schemas:generate": "node ./scripts/generate-provider-schemas.mjs",
    "gateway:demo": "node ./gateway/index.mjs",
    "evals:run": "node ./evals/runner.mjs",
    "openai:demo": "node ./providers/openai/run.mjs --dry-run",
    "anthropic:demo": "node ./providers/anthropic/run.mjs --dry-run",
    "gemini:demo": "node ./providers/gemini/run.mjs --dry-run",
    "groq:demo": "node ./providers/groq/run.mjs --dry-run",
    "perplexity:demo": "node ./providers/perplexity/run.mjs --dry-run",
    "mistral:demo": "node ./providers/mistral/run.mjs --dry-run",
    "xai:demo": "node ./providers/xai/run.mjs --dry-run",
    "cohere:demo": "node ./providers/cohere/run.mjs --dry-run",
    "local:demo": "node ./providers/local/run.mjs --dry-run",
    "all:demo": "node ./scripts/run-all-demos.mjs"
  }
}
